    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@evolai/contracts": "workspace:*",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "2.1.5"
  }
}
