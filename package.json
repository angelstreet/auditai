{
  "name": "auditai",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source platform for evidence-based AI adoption audits and AI change enablement. Working name.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=9.12"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "leak-scan": "node scripts/leak-scan.mjs",
    "ci": "pnpm install --frozen-lockfile && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run leak-scan",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@vitest/coverage-v8": "2.1.5",
    "embedded-postgres": "17.5.0-beta.15",
    "eslint": "9.13.0",
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vitest": "2.1.5"
  }
}
