{
  "name": "evolai",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source platform for evidence-based AI adoption audits and AI change enablement. Working name.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=9.12"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "leak-scan": "node scripts/leak-scan.mjs",
    "style-guard": "node scripts/style-guard.mjs",
    "ci": "pnpm install --frozen-lockfile && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:scripts && pnpm run leak-scan && pnpm run style-guard",
    "clean": "turbo run clean && rm -rf node_modules",
    "local:up": "node apps/web/scripts/local-stack.mjs up",
    "local:down": "node apps/web/scripts/local-stack.mjs down",
    "local:reset": "node apps/web/scripts/local-stack.mjs reset",
    "local:status": "node apps/web/scripts/local-stack.mjs status",
    "local:smoke": "node apps/web/scripts/local-smoke.mjs",
    "test:e2e": "pnpm local:smoke && pnpm m10:smoke && pnpm m11:smoke && pnpm m12:smoke && pnpm m13:smoke && pnpm m14:smoke && pnpm m15:smoke && pnpm m15b:smoke && pnpm n:smoke && pnpm m16:smoke",
    "coverage": "turbo run test -- --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text --coverage.include='src/**/*.ts' && node scripts/coverage-threshold.mjs",
    "m10:smoke": "node apps/web/scripts/m10-smoke.mjs",
    "m11:smoke": "node apps/web/scripts/m11-smoke.mjs",
    "m12:smoke": "node apps/web/scripts/m12-smoke.mjs",
    "m13:smoke": "node apps/web/scripts/m13-smoke.mjs",
    "m14:smoke": "node apps/web/scripts/m14-smoke.mjs",
    "m15:smoke": "node apps/web/scripts/m15-smoke.mjs",
    "auditor:create": "node infra/db/scripts/auditor.mjs create",
    "auditor:set-password": "node infra/db/scripts/auditor.mjs set-password",
    "auditor:disable": "node infra/db/scripts/auditor.mjs disable",
    "auditor:set-email": "node infra/db/scripts/auditor.mjs set-email",
    "seed:client": "node infra/db/scripts/client-seed.mjs",
    "retention:run": "pnpm --filter @evolai/ai run retention-run",
    "ai:eval": "pnpm --filter @evolai/ai run eval",
    "m15b:smoke": "node apps/web/scripts/m15b-smoke.mjs",
    "n:smoke": "node apps/web/scripts/n-smoke.mjs",
    "m16:smoke": "node apps/web/scripts/m16-smoke.mjs",
    "test:scripts": "node --test scripts/style-guard.test.mjs scripts/adr-numbers.test.mjs",
    "test:e2e:browser": "pnpm --filter @evolai/web exec playwright test"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@vitest/coverage-v8": "2.1.5",
    "embedded-postgres": "17.5.0-beta.15",
    "eslint": "9.13.0",
    "pg": "8.13.1",
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vitest": "2.1.5"
  }
}
